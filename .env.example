# Bu dosyayı ".env" adıyla kopyala ve doldur. ".env" GitHub'a gönderilmez.
# Token'lar BURAYA YAZILMAZ: "beta-social token set ..." komutu onları
# Windows Kimlik Yöneticisi'nde (Credential Manager) saklar.

# --- Instagram (Instagram API with Instagram Login) ---
# Meta geliştirici panelindeki Instagram uygulama kimliği ve gizli anahtarı
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# graph.instagram.com sürümü (Meta panelinde görünen güncel sürümü yaz)
INSTAGRAM_API_VERSION=v25.0

# --- TikTok (Login Kit + Display API + Content Posting API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok geliştirici panelinde kayıtlı yönlendirme adresiyle birebir aynı olmalı
TIKTOK_REDIRECT_URI=
TIKTOK_SCOPES=user.info.basic,user.info.stats,video.list

# --- Yerel ayarlar ---
# Veritabanı ve raporların klasörü (boş bırakılırsa proje içindeki data/ ve reports/)
BETA_DATA_DIR=
BETA_REPORTS_DIR=
